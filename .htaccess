# Docs, editor files and dotfiles are for developers only - never serve them from the public site.
<FilesMatch "(^\.|\.(md|code-workspace|env|local|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The server copy is a git clone: never serve the .git folder (FilesMatch above only checks file names, not folders)
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git(/|$)
</IfModule>
